generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Asset {
  id            String   @id @default(uuid())
  userId        String   @default("default")
  name          String
  category      String
  subType       String?
  tickerSymbol  String?
  exchangeCode  String?
  priceSource   String   @default("MANUAL")
  track         String   @default("unclassified")
  quantity      Float
  unitPrice     Float
  totalValue    Float
  currency      String   @default("CNY")
  costBasis     Float?
  passiveIncome Float?
  properties    Json?
  acquiredAt    DateTime?
  notes         String?
  priceUpdatedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions Transaction[]

  @@index([userId])
  @@index([userId, category])
}

model Liability {
  id             String   @id @default(uuid())
  userId         String   @default("default")
  name           String
  type           String
  totalAmount    Float
  remaining      Float
  interestRate   Float?
  monthlyPayment Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model FireProfile {
  userId              String @id @default("default")
  annualExpense       Float
  safeWithdrawalRate  Float  @default(0.04)
  fireTarget          Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AllocationTarget {
  id          String @id @default(uuid())
  userId      String @default("default")
  category    String
  targetRatio Float
  updatedAt   DateTime @updatedAt

  @@unique([userId, category])
  @@index([userId])
}

model Snapshot {
  id              String   @id @default(uuid())
  userId          String   @default("default")
  snapshotDate    DateTime @default(now())
  totalAssets     Float
  totalLiabilities Float
  netWorth        Float
  breakdown       Json
  createdAt       DateTime @default(now())

  @@index([userId, snapshotDate])
}

model MarketPrice {
  tickerSymbol    String
  exchangeCode    String
  name            String?
  currentPrice    Float
  previousClose   Float?
  dayChange       Float?
  dayChangePercent Float?
  updatedAt       DateTime @default(now())

  @@id([tickerSymbol, exchangeCode])
}

model ExchangeRate {
  fromCurrency String
  toCurrency   String   @default("CNY")
  rate         Float
  updatedAt    DateTime @default(now())

  @@id([fromCurrency, toCurrency])
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String   @default("default")
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type      String
  date      DateTime
  quantity  Float?
  price     Float?
  amount    Float
  fee       Float?   @default(0)
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([assetId])
}

model RebalanceAlert {
  userId    String
  category  String
  threshold Float   @default(5)
  enabled   Boolean @default(true)

  @@id([userId, category])
}

model StrategyTemplate {
  id          String   @id @default(uuid())
  name        String
  type        String
  description String
  suitableFor String
  indicators  Json
  allocation  Json
  examples    Json?
  riskLevel   String
  createdAt   DateTime @default(now())
}

model MarketIndicator {
  id            String   @id @default(uuid())
  market        String   @default("A_STOCK")
  indicatorType String
  category      String
  data          Json
  fetchedAt     DateTime @default(now())

  @@unique([market, indicatorType, category])
  @@index([fetchedAt])
}

model SignalRecord {
  id          String   @id @default(uuid())
  market      String   @default("A_STOCK")
  track       String
  targetCode  String
  targetName  String
  score       Float
  factors     Json
  stage       String   @default("mid")
  backtest    Json?
  triggeredAt DateTime @default(now())

  journals    SignalJournal[]

  @@index([market, track])
  @@index([triggeredAt])
}

model SignalJournal {
  id        String   @id @default(uuid())
  userId    String   @default("default")
  signalId  String
  signal    SignalRecord @relation(fields: [signalId], references: [id], onDelete: Cascade)
  note      String   @default("")
  action    String   @default("watched")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([signalId])
  @@unique([userId, signalId])
}
