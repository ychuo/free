{
  "name": "free",
  "private": true,
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "up": "(cd server && bun run dev) & (cd web && bun run dev) & wait",
    "build": "turbo run build",
    "db:migrate": "cd server && bunx prisma migrate dev",
    "db:seed": "cd server && bun run prisma/seed.ts",
    "db:studio": "cd server && bunx prisma studio",
    "lint": "biome check",
    "format": "biome check --write",
    "ci": "biome ci"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "turbo": "^2.9.8"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "react-day-picker": "^9.14.0"
  }
}
